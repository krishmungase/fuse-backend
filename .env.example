NODE_ENV=development
PORT=3000
APP_NAME=zenith-backend

DB_HOST=localhost
DB_PORT=5432
DB_NAME=zenith
DB_USER=postgres
DB_PASSWORD=postgres

JWT_ACCESS_SECRET=super_secret_access_key_dev
JWT_REFRESH_SECRET=super_secret_refresh_key_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Signs the short-lived tokens in verification emails. Keep it distinct from
# the session secrets so a leaked mail link can never act as a session.
JWT_EMAIL_SECRET=super_secret_email_key_dev
JWT_EMAIL_VERIFY_EXPIRES_IN=30m
JWT_PASSWORD_SETUP_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:5173

# Minimum gap between verification emails for the same address
MAIL_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Fuse AI
SMTP_FROM_EMAIL=

# false = skip the broker and send verification emails inline
USE_RABBITMQ_SERVICE=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# LLM providers. Only the keys for providers you actually use are needed --
# the app boots without them and fails per-request if a selected model's
# provider has no key. Models are allowlisted in
# src/app/workflow/models.registry.ts and served by GET /api/v1/chat/models.
GROQ_API_KEY=
OPENAI_API_KEY=
